{
  "manifest_version": 3,
  "name": "Cameo Bridge",
  "version": "0.2.0",
  "description": "Reports real tab facts to Cameo on this computer and performs tab actions it requests. No page access.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "alarms", "background"],
  "background": {"service_worker": "background.js"}
}
